{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.(js|css|png|jpg|jpeg|svg|gif|ico|json)",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/utilisateurs/([^/]+)", "dest": "/api/utilisateurs/[id].js" },
    { "src": "/api/utilisateurs", "dest": "/api/utilisateurs.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}